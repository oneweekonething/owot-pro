# Export these variables in your shell; the server does not auto-load .env files.
OWOT_MYSQL_DSN='root:owot_test@tcp(127.0.0.1:13306)/owot_pro_test?charset=utf8mb4&parseTime=true&loc=UTC'
OWOT_REDIS_ADDR=127.0.0.1:16379
OWOT_REDIS_PASSWORD=
# Comma-separated frontend origins; unset permits any origin without cookie credentials.
OWOT_CORS_ORIGINS=http://localhost:5173,http://localhost:80
# Persistent directory for profile images; defaults to data/iam-avatars.
OWOT_AVATAR_DIR=./data/iam-avatars

OWOT_TEST_MYSQL_DSN='root:owot_test@tcp(127.0.0.1:13306)/owot_pro_test?charset=utf8mb4&parseTime=true&loc=UTC'
OWOT_TEST_REDIS_ADDR=127.0.0.1:16379
